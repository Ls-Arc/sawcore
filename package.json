{
  "name": "sawcore",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bunx tsc -b",
    "build:node": "tsc -b",
    "clean": "bunx tsc -b --clean",
    "clean:node": "tsc -b --clean",
    "ci:smoke": "bun run local:smoke",
    "ci:verify": "bun run typecheck && bun run build && bun run test && bun run local:config",
    "front:dev": "bun run --cwd apps/front dev",
    "front:build": "bun run --cwd apps/front build",
    "front:preview": "bun run --cwd apps/front preview",
    "local:down": "docker compose -f infra/docker-compose.yml down -v --remove-orphans",
    "local:smoke": "bun test apps/web/test/docker-compose-smoke.test.ts",
    "local:up": "docker compose -f infra/docker-compose.yml up --build",
    "local:config": "docker compose -f infra/docker-compose.yml config",
    "web:start": "bun apps/web/src/server.ts",
    "typecheck": "bunx tsc -b --pretty false",
    "typecheck:node": "tsc -b --pretty false",
    "test": "bun run build && bun test",
    "test:node": "bun run build:node && node --test",
    "verify:node": "bun run typecheck:node && bun run test:node"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "bun@1.3.13"
}
